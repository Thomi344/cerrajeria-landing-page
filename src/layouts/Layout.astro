---
import Whatsapp from '../components/whatsapp.astro';
import ImageAutoHero from '../assets/images/AutoHero.webp';
import { getImage } from 'astro:assets';
import { zonas } from '../data/zonas';
import { TELEFONO } from '../utils/contacto';
import { PUBLIC_GTM_ID, PUBLIC_GOOGLE_SITE_VERIFICATION } from 'astro:env/client';

interface Props {
    title?: string;
    description?: string;
    nombreZona?: string;
    preloadHero?: boolean; // --- Solo las páginas con Hero precargan su imagen LCP ---
    noindex?: boolean;
}

const { 
    title = "Cerrajería Wally 24hs | Urgencias en GBA y CABA | ¡Llamá ahora!",
    description = "Cerrajero a domicilio 24 horas. Apertura de puertas, autos y cajas fuertes. Rápidos, limpios y con garantía en el día.",
    nombreZona = "CABA y GBA",
    preloadHero = false,
    noindex = false
} = Astro.props;

// --- Imagen del hero optimizada (mismos parámetros que en Hero.astro para reutilizar los archivos) ---
const ImageAutoHeroPreload = preloadHero
    ? await getImage({ 
        src: ImageAutoHero, 
        format: 'webp',
        widths: [600, 900, 1500],
        sizes: "(max-width: 600px) 600px, (max-width: 1200px) 900px, 1500px"
    })
    : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/SocialShare-1.jpg', Astro.site);

const businessSchema = {
    "@context": "https://schema.org",
    "@type": "Locksmith",
    "name": "Cerrajería Wally",
    "image": new URL('/logo-icon.webp', Astro.site),
    "@id": Astro.site,
    "url": Astro.site,
    "telephone": TELEFONO,
    "priceRange": "$$",
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "Buenos Aires",
        "addressCountry": "AR"
    },
    "areaServed": zonas.map((zona) => ({
        "@type": "Place",
        "name": zona.nombre
    })),
    "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
        "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
        ],
        "opens": "00:00",
        "closes": "23:59"
    }
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        <!-- Hilo principal: Inicializamos la capa de datos para que los clicks funcionen -->

        <!-- 3. Google Tag Manager original (Para que Analytics no pierda datos) -->
        <script is:inline define:vars={{ gtmId: PUBLIC_GTM_ID }}>
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer',gtmId);
        </script>

        <link rel="icon" type="image/webp" href="/logo-icon.webp" />
        <!-- Forzar precarga de la imagen LCP del Hero -->
        {ImageAutoHeroPreload && (
            <link rel="preload" as="image" imagesrcset={ImageAutoHeroPreload.srcSet.attribute} imagesizes={ImageAutoHeroPreload.attributes.sizes} fetchpriority="high" />
        )}

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:site_name" content="Cerrajería Wally" />
        <meta property="og:locale" content="es_AR" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} />
        
        <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    </head>
    <body class="bg-fondo-base text-slate-200 selection:bg-blue-500/30">
        <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${PUBLIC_GTM_ID}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <slot /> 
        <Whatsapp nombreZona={nombreZona} />
    </body>
</html>

<style is:global>
    /* Optimizamos la carga de Tailwind */
    @import 'tailwindcss';
    @import 'tailwind-animations';

    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100vh;
        /* Suavizamos el renderizado de fuentes para mejorar el Speed Index */
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    @theme {
        --color-marca: #2563eb; 
        --color-marca-hover: #1d4ed8; 
        --color-marca-suave: #3b82f6; 
        --color-wpp: #22c55e; 
        --color-wpp-hover: #16a34a; 
        --color-fondo-base: #0f172a; 
        --color-fondo-nav: #020617;  
        --color-fondo-card: #1e293b; 
        --color-borde: #334155;      
    }
</style>