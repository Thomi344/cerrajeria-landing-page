---
// src/pages/[zona].astro

import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '../layouts/Layout.astro';
import Header from '../sections/Header.astro';
import Hero from '../sections/Hero.astro';
import Footer from '../sections/Footer.astro';
import { zonas } from '../data/zonas';
import { limpiarParaUrl } from '../utils/slug';
import Servicios from '../sections/Servicios.astro';
import Beneficios from '../sections/Beneficios.astro';
import Galeria from '../sections/Galeria.astro';
import Opiniones from '../sections/Opiniones.astro';
import Faq from '../sections/Faq.astro';

export const getStaticPaths = (() => {
    // --- Mapeamos cada zona (y cada barrio) para crear su página automáticamente ---
    // Ej: /cerrajero-zona-lomas-de-zamora/ y /cerrajero-zona-banfield/
    return zonas.flatMap((zonaData) =>
        [zonaData.nombre, ...zonaData.barrios].map((nombreDinamico) => ({
            params: { zona: `cerrajero-zona-${limpiarParaUrl(nombreDinamico)}` },
            props: { infoZona: { ...zonaData, nombreDinamico } },
        }))
    );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

// --- Recibimos la información de la zona en la que estamos parados ---
const { infoZona } = Astro.props as Props;
---

<Layout
    title={`Cerrajero de Urgencia en ${infoZona.nombreDinamico} | 24 Horas | Wally`}
    description={`¿Necesitás un cerrajero rápido en ${infoZona.nombreDinamico}? Apertura de autos, casas y cajas fuertes las 24hs. Servicio garantizado en ${infoZona.region}.`}
    nombreZona={infoZona.nombreDinamico}
    preloadHero
    >
    <Header nombreZona={infoZona.nombreDinamico} />

    <Hero
        nombreZona={infoZona.nombreDinamico}
        region={infoZona.region}
        barrios={infoZona.barrios}
    />

    <Servicios region={infoZona.region} nombreZona={infoZona.nombreDinamico} />

    <Beneficios region={infoZona.region} nombreZona={infoZona.nombreDinamico} />

    <Galeria region={infoZona.region} nombreZona={infoZona.nombreDinamico} />

    <Opiniones region={infoZona.region} nombreZona={infoZona.nombreDinamico} />

    <Faq region={infoZona.region} nombreZona={infoZona.nombreDinamico} />

    <Footer/>
</Layout>
